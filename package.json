    "render": "node scripts/check-placeholders.mjs && node --no-warnings scripts/render-final.mjs",
    "render:draft": "node --no-warnings scripts/render-final.mjs --draft",
    "stills": "node scripts/render-stills.mjs",
    "audit": "python scripts/audit.py"
  },
  "allowScripts": {
    "esbuild": false
  }
