  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "check": "node scripts/check-placeholders.mjs",
    "voz:sintetica": "node --no-warnings scripts/sync.mjs --sintetica",
    "voz:importar": "node --no-warnings scripts/sync.mjs --importar",
