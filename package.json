    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/captions": "^4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "^4.0.538",
    "@remotion/install-whisper-cpp": "^4.0.538",
    "@remotion/player": "^4.0.538",
    "@remotion/transitions": "^4.0.538",
    "@remotion/zod-types": "^4.0.538",
    "lucide-react": "^1.61.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^7.3.7"
